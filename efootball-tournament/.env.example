PORT=3000
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/efootball_tournament
JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace-with-a-strong-password
ENTRY_FEE=200
CAPACITY=1000
TOURNAMENT_START=2026-12-31T10:00:00+03:00
MPESA_PAYBILL=XXXXXX
MPESA_ACCOUNT=EFOOTBALL
MPESA_NAME=Your organisation
NODE_ENV=development

# KCB Buni (M-PESA STK push). Use the same KCB Buni app as the certification portal.
BUNI_CLIENT_ID=
BUNI_CLIENT_SECRET=
